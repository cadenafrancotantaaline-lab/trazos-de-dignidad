// Sorpresas aleatorias: caen recursos que representan apoyo comunitario.
const lluviaOverlay=document.getElementById('lluviaOverlay');
const sorpresas=[
 {nombre:'Apoyo económico',iconos:['💸','🪙','💵','💖'],mensaje:'¡Llegó apoyo económico para la comunidad! 💸'},
 {nombre:'Libros',iconos:['📚','📖','✏️','📒'],mensaje:'¡Una lluvia de libros para aprender y crecer! 📚'},
 {nombre:'Alimentos',iconos:['🍎','🥕','🍞','🥦','🍊'],mensaje:'¡Llegaron alimentos frescos para compartir! 🍎'}
];
function lanzarSorpresa(){
 // Solo aparece cuando la persona está en el lienzo interactivo.
 if(!document.getElementById('lienzo').classList.contains('seccion-activa')){programarSorpresa(3500);return}
 const sorpresa=sorpresas[Math.floor(Math.random()*sorpresas.length)];
 const mensaje=document.createElement('div');mensaje.className='mensaje-sorpresa';mensaje.textContent=sorpresa.mensaje;lluviaOverlay.appendChild(mensaje);
 const cantidad=20;
 for(let i=0;i<cantidad;i++){
  const particula=document.createElement('span');particula.className='particula-caida';
  particula.textContent=sorpresa.iconos[Math.floor(Math.random()*sorpresa.iconos.length)];
  particula.style.left=(Math.random()*94+2)+'%';
  particula.style.setProperty('--duracion',(2.4+Math.random()*2.2)+'s');
  particula.style.setProperty('--alto',(canvas.clientHeight||520)+'px');
  particula.style.setProperty('--deriva',((Math.random()-.5)*150)+'px');
  particula.style.setProperty('--giro',((Math.random()-.5)*800)+'deg');
  particula.style.animationDelay=(Math.random()*.9)+'s';
  lluviaOverlay.appendChild(particula);
  setTimeout(()=>particula.remove(),6000);
 }
 setTimeout(()=>mensaje.remove(),3500);
 programarSorpresa(14000+Math.random()*16000);
}
function programarSorpresa(ms){setTimeout(lanzarSorpresa,ms)}
// La primera sorpresa aparece después de unos segundos; las siguientes son impredecibles.
programarSorpresa(7000+Math.random()*5000);
